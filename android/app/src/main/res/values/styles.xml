<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Thème du démarrage, avant le premier écran Flutter. Sombre dans
         tous les cas : l'application n'a pas de thème clair, et un fond
         blanc le temps du lancement faisait un éclair avant le violet. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Thème posé derrière Flutter une fois lancé. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/fond</item>
    </style>
</resources>
